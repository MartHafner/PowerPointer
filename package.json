{
  "name": "powerpointer",
  "version": "2.0.2",
  "description": "The local PowerPoint remote control for iPhone, macOS and Windows.",
  "main": "desktop/main.js",
  "bin": {
    "powerpointer": "server/server.js"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "debug": "cross-env DEBUG=1 electron .",
    "dev": "cross-env POWERPOINTER_MOCK=1 electron .",
    "server:dev": "cross-env POWERPOINTER_MOCK=1 node server/server.js",
    "desktop": "electron .",
    "desktop:dev": "cross-env POWERPOINTER_MOCK=1 electron .",
    "build:win": "electron-builder --win nsis --x64",
    "dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "allowScripts": {
    "electron@45.3.2": true
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.github.marthafner.powerpointer",
    "productName": "PowerPointer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "config/**/*",
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "publish": [
        { "provider": "github", "owner": "MartHafner", "repo": "PowerPointer" }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/assets/icon.ico"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "desktop/assets/icon.png",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "PowerPointer needs to control Microsoft PowerPoint to change slides."
      }
    }
  }
}
