{
  "name": "powerpointer",
  "version": "2.0.0",
  "description": "The local PowerPoint remote control for iPhone, macOS and Windows.",
  "main": "desktop/main.js",
  "bin": {
    "powerpointer": "server/server.js"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "debug": "cross-env DEBUG=1 electron .",
    "dev": "cross-env POWERPOINTER_MOCK=1 electron .",
    "server:dev": "cross-env POWERPOINTER_MOCK=1 node server/server.js",
    "desktop": "electron .",
    "desktop:dev": "cross-env POWERPOINTER_MOCK=1 electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "allowScripts": {
    "electron@45.3.2": true
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.marthafner.powerpointer",
    "productName": "PowerPointer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "config/**/*",
      "desktop/**/*",
      "public/**/*",
      "server/**/*",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
