{
  "name": "powerpointer",
  "version": "1.1.3",
  "description": "The local PowerPoint remote control for iPhone, macOS and Windows.",
  "main": "desktop/main.js",
  "bin": {
    "powerpointer": "server/server.js"
  },
  "scripts": {
    "start": "node server/server.js",
    "desktop": "electron .",
    "debug": "DEBUG=1 node server/server.js",
    "dev": "POWERPOINTER_MOCK=1 node server/server.js",
    "desktop:dev": "POWERPOINTER_MOCK=1 electron ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "license": "MIT",
  "allowScripts": {
    "electron@33.4.11": true
  }
}
